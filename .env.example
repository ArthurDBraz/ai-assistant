# Ollama server (LLM provider). Override per environment.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Default location used when the user doesn't specify one.
DEFAULT_CITY=Porto Alegre
DEFAULT_LATITUDE=-30.03
DEFAULT_LONGITUDE=-51.23

# Home Assistant configs
HOME_ASSISTANT_HOST=http://localhost:8123
# Set security token for HA API
# HOME_ASSISTANT_TOKEN=<long-lived-token>